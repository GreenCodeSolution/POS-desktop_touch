<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXPasswordField?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<VBox fx:id="mainContainer" xmlns="http://javafx.com/javafx/20.0.1"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.devstack.pos.controller.LoginFormController"
      stylesheets="@styles/modern-touch.css" styleClass="background-touch" spacing="0">
    <children>
        <!-- Blue Header Bar -->
    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #1e3a8a; -fx-padding: 15 40;">
        <Text text="QuickPOS" style="-fx-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="15">
            <Text fx:id="lblTime" text="12:00" style="-fx-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 30; -fx-padding: 8 20;">
                <Text fx:id="lblDate" text="Fri 10 Apr 2026" style="-fx-fill: white; -fx-font-size: 16px;"/>
            </HBox>
        </HBox>
    </HBox>

        <HBox fx:id="context" alignment="CENTER" VBox.vgrow="ALWAYS" spacing="0">
            <children>
        <!-- Left Side: Login Form -->
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS" 
              style="-fx-background-image: url('assets/login_bg.png'); -fx-background-size: cover; -fx-background-position: center;">
            <!-- Main Two-Column Container -->
            <VBox alignment="CENTER" spacing="20" maxWidth="950" 
                  style="-fx-padding: 40 50; -fx-background-color: white; -fx-background-radius: 32; -fx-border-color: #e2e8f0; -fx-border-width: 1;">
                
                <HBox spacing="40" alignment="CENTER">
                    <!-- Left Column: Staff Profiles -->
                    <VBox spacing="15" alignment="TOP_LEFT" prefWidth="420">
                        <VBox alignment="TOP_LEFT" spacing="5">
                            <Text text="GreenCode POS" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #6366f1;"/>
                            <Text text="Staff login" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-fill: #1e293b;"/>
                            <Text text="Select your account" style="-fx-font-size: 16px; -fx-fill: #94a3b8;"/>
                        </VBox>
                        
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 15 0;">
                            <VBox fx:id="profileContainer" spacing="15" alignment="TOP_LEFT">
                                <!-- Horizontal Profile Cards injected here -->
                            </VBox>
                        </ScrollPane>
                        
                        <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10 0;">
                            <Text text="Forgot PIN? Contact admin" style="-fx-font-size: 14px; -fx-fill: #64748b;"/>
                        </HBox>
                    </VBox>
                    
                    <!-- Vertical Divider -->
                    <Pane prefWidth="2" style="-fx-background-color: #f1f5f9; -fx-min-height: 450;"/>
                    
                    <!-- Right Column: PIN & Keypad -->
                    <VBox spacing="20" alignment="CENTER" prefWidth="350" style="-fx-background-color: #f8fafc; -fx-background-radius: 0 32 32 0; -fx-padding: 0 0 0 40; -fx-border-color: #f1f5f9; -fx-border-width: 0 0 0 1;">
                        <VBox alignment="CENTER" spacing="15">
                            <Text text="Enter PIN" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #64748b;"/>
                            
                            <!-- PIN Indicator Dots (Hollow) -->
                            <HBox alignment="CENTER" spacing="15" fx:id="pinDotsContainer">
                                <Pane style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-background-radius: 50; -fx-min-width: 18; -fx-min-height: 18;"/>
                                <Pane style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-background-radius: 50; -fx-min-width: 18; -fx-min-height: 18;"/>
                                <Pane style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-background-radius: 50; -fx-min-width: 18; -fx-min-height: 18;"/>
                                <Pane style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-background-radius: 50; -fx-min-width: 18; -fx-min-height: 18;"/>
                            </HBox>
                            
                            <JFXPasswordField fx:id="txtPassword" visible="false" managed="true" prefHeight="1"/>
                        </VBox>

                        <!-- Integrated Numeric Keypad (Styled like image) -->
                        <GridPane alignment="CENTER" hgap="15" vgap="15" styleClass="keypad" style="-fx-background-color: transparent;">
                            <JFXButton text="1" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="keypad-btn-modern" prefWidth="85" prefHeight="75" onAction="#btnKeypadPressed"/>
                            <JFXButton text="2" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="keypad-btn-modern" prefWidth="85" prefHeight="75" onAction="#btnKeypadPressed"/>
                            <JFXButton text="3" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="keypad-btn-modern" prefWidth="85" prefHeight="75" onAction="#btnKeypadPressed"/>
                            
                            <JFXButton text="4" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="keypad-btn-modern" prefWidth="85" prefHeight="75" onAction="#btnKeypadPressed"/>
                            <JFXButton text="5" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="keypad-btn-modern" prefWidth="85" prefHeight="75" onAction="#btnKeypadPressed"/>
                            <JFXButton text="6" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="keypad-btn-modern" prefWidth="85" prefHeight="75" onAction="#btnKeypadPressed"/>
                            
                            <JFXButton text="7" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="keypad-btn-modern" prefWidth="85" prefHeight="75" onAction="#btnKeypadPressed"/>
                            <JFXButton text="8" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="keypad-btn-modern" prefWidth="85" prefHeight="75" onAction="#btnKeypadPressed"/>
                            <JFXButton text="9" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="keypad-btn-modern" prefWidth="85" prefHeight="75" onAction="#btnKeypadPressed"/>
                            
                            <JFXButton text="c" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="keypad-btn-modern" prefWidth="85" prefHeight="75" style="-fx-text-fill: #ef4444;" onAction="#btnKeypadClear"/>
                            <JFXButton text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="keypad-btn-modern" prefWidth="85" prefHeight="75" onAction="#btnKeypadPressed"/>
                            <JFXButton text="⌫" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="keypad-btn-modern" prefWidth="85" prefHeight="75" onAction="#btnKeypadBackspace"/>
                        </GridPane>
                        
                        <JFXButton text="Access terminal" onAction="#btnSignInOnAction" 
                                   style="-fx-background-color: #f8fafc; -fx-text-fill: #f1f5f9; -fx-font-size: 16px; -fx-border-color: #f1f5f9; -fx-border-radius: 12; -fx-padding: 15 60;"/>
                    </VBox>
                </HBox>
                
                <!-- Simple Footer -->
                <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                    <Text text="© 2026 GreenCode Solutions" style="-fx-font-size: 11px; -fx-fill: #cbd5e1;"/>
                </HBox>
            </VBox>
        </VBox>
        
            </children>
        </HBox>
    </children>
</VBox>

