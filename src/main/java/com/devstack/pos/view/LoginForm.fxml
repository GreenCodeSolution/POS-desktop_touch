<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXPasswordField?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<VBox fx:id="context" alignment="CENTER" xmlns="http://javafx.com/javafx/20.0.1"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.devstack.pos.controller.LoginFormController"
      stylesheets="@styles/modern-touch.css" styleClass="background-touch">
    <children>
        <VBox alignment="CENTER" spacing="35" maxWidth="500" 
              style="-fx-padding: 60; -fx-background-color: white; -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 30, 0, 0, 15);">
            <!-- Branding Section -->
            <VBox alignment="CENTER" spacing="12">
                <Text text="GreenCode POS" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-fill: #1e293b;"/>
                <Text text="Sign in to your terminal" style="-fx-font-size: 16px; -fx-fill: #64748b;"/>
            </VBox>

            <!-- Input Section -->
            <VBox spacing="20" prefWidth="380.0">
                <VBox spacing="8">
                    <Text text="Username / Email" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #1e293b;"/>
                    <JFXTextField fx:id="txtEmail" promptText="terminal@greencode.com" 
                                  styleClass="text-field-modern" prefHeight="55.0"
                                  style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-font-size: 16px;"/>
                </VBox>

                <VBox spacing="8">
                    <Text text="Password" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #1e293b;"/>
                    <JFXPasswordField fx:id="txtPassword" promptText="••••••••"
                                      styleClass="text-field-modern" prefHeight="55.0"
                                      style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-font-size: 16px;"/>
                </VBox>
            </VBox>

            <!-- Action Section -->
            <VBox spacing="20" alignment="CENTER" maxWidth=" Infinity">
                <JFXButton onAction="#btnSignInOnAction" text="ACCESS TERMINAL" 
                           styleClass="btn-touch, btn-touch-primary"
                           prefWidth="380.0" prefHeight="65.0" 
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                
                <Text text="Forgot password? Contact Administrator" style="-fx-font-size: 13px; -fx-fill: #94a3b8;"/>
            </VBox>

            <!-- Small Footer -->
            <HBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
                <Text text="Powered by" style="-fx-font-size: 12px; -fx-fill: #cbd5e1;"/>
                <Text text="GreenCode Solutions" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-fill: #94a3b8;"/>
            </HBox>
        </VBox>
    </children>
</VBox>
