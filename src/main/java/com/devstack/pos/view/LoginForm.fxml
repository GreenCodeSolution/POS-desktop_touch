<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXPasswordField?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<HBox fx:id="context" alignment="CENTER" xmlns="http://javafx.com/javafx/20.0.1"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.devstack.pos.controller.LoginFormController"
      stylesheets="@styles/modern-touch.css" styleClass="background-touch" spacing="0">
    <children>
        <!-- Left Side: Login Form -->
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: white;">
            <VBox alignment="CENTER" spacing="35" maxWidth="500" 
                  style="-fx-padding: 60;">
                <!-- Branding Section -->
                <VBox alignment="CENTER" spacing="12">
                    <Text text="GreenCode POS" style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-fill: #1e293b;"/>
                    <Text text="Sign in to your terminal" style="-fx-font-size: 18px; -fx-fill: #64748b;"/>
                </VBox>

                <!-- Input Section -->
                <VBox spacing="20" prefWidth="380.0">
                    <VBox spacing="8" visible="false" managed="false">
                        <Text text="User Email" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #1e293b;"/>
                        <JFXTextField fx:id="txtEmail" promptText="terminal@greencode.com" 
                                      styleClass="text-field-modern" prefHeight="65.0"
                                      style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-font-size: 18px;"/>
                    </VBox>

                    <VBox spacing="8">
                        <Text text="Terminal PIN" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #1e293b;"/>
                        <JFXPasswordField fx:id="txtPassword" promptText="••••••••"
                                          styleClass="text-field-modern" prefHeight="65.0"
                                          style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-font-size: 24px; -fx-letter-spacing: 5px;"/>
                    </VBox>
                </VBox>

                <!-- Action Section -->
                <VBox spacing="20" alignment="CENTER" maxWidth="Infinity">
                    <JFXButton onAction="#btnSignInOnAction" text="ACCESS TERMINAL" 
                               styleClass="btn-touch, btn-touch-primary"
                               prefWidth="380.0" prefHeight="75.0" 
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                    
                    <Text text="Forgot PIN? Contact Administrator" style="-fx-font-size: 14px; -fx-fill: #94a3b8;"/>
                </VBox>

                <!-- Small Footer -->
                <HBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
                    <Text text="Powered by" style="-fx-font-size: 13px; -fx-fill: #cbd5e1;"/>
                    <Text text="GreenCode Solutions" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-fill: #94a3b8;"/>
                </HBox>
            </VBox>
        </VBox>
        
        <!-- Right Side: Touch Keypad -->
        <VBox alignment="CENTER" HBox.hgrow="SOMETIMES" prefWidth="500" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 0 1;">
            <VBox alignment="CENTER" spacing="10">
                <Text text="Enter PIN" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #1e293b; -fx-padding: 0 0 20 0;"/>
                <GridPane alignment="CENTER" hgap="15" vgap="15" styleClass="keypad">
                    <!-- Row 1 -->
                    <JFXButton text="1" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="keypad-btn" prefWidth="100" prefHeight="90" style="-fx-font-size: 28px;" onAction="#btnKeypadPressed"/>
                    <JFXButton text="2" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="keypad-btn" prefWidth="100" prefHeight="90" style="-fx-font-size: 28px;" onAction="#btnKeypadPressed"/>
                    <JFXButton text="3" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="keypad-btn" prefWidth="100" prefHeight="90" style="-fx-font-size: 28px;" onAction="#btnKeypadPressed"/>
                    
                    <!-- Row 2 -->
                    <JFXButton text="4" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="keypad-btn" prefWidth="100" prefHeight="90" style="-fx-font-size: 28px;" onAction="#btnKeypadPressed"/>
                    <JFXButton text="5" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="keypad-btn" prefWidth="100" prefHeight="90" style="-fx-font-size: 28px;" onAction="#btnKeypadPressed"/>
                    <JFXButton text="6" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="keypad-btn" prefWidth="100" prefHeight="90" style="-fx-font-size: 28px;" onAction="#btnKeypadPressed"/>
                    
                    <!-- Row 3 -->
                    <JFXButton text="7" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="keypad-btn" prefWidth="100" prefHeight="90" style="-fx-font-size: 28px;" onAction="#btnKeypadPressed"/>
                    <JFXButton text="8" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="keypad-btn" prefWidth="100" prefHeight="90" style="-fx-font-size: 28px;" onAction="#btnKeypadPressed"/>
                    <JFXButton text="9" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="keypad-btn" prefWidth="100" prefHeight="90" style="-fx-font-size: 28px;" onAction="#btnKeypadPressed"/>
                    
                    <!-- Row 4 -->
                    <JFXButton text="C" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="keypad-btn" prefWidth="100" prefHeight="90" style="-fx-font-size: 24px; -fx-text-fill: #ef4444;" onAction="#btnKeypadClear"/>
                    <JFXButton text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="keypad-btn" prefWidth="100" prefHeight="90" style="-fx-font-size: 28px;" onAction="#btnKeypadPressed"/>
                    <JFXButton text="⌫" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="keypad-btn" prefWidth="100" prefHeight="90" style="-fx-font-size: 24px;" onAction="#btnKeypadBackspace"/>
                </GridPane>
            </VBox>
        </VBox>
    </children>
</HBox>

