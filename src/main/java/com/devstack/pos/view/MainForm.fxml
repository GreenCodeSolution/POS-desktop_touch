<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>

<AnchorPane fx:id="mainContext" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.devstack.pos.controller.MainFormController"
            stylesheets="@styles/modern-touch.css"
            styleClass="background-touch">
   <children>

      <!-- Modern Compact Sidebar (Always Minimized) -->
      <VBox styleClass="sidebar-touch"
            AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
         <children>
            <VBox alignment="CENTER" style="-fx-padding: 0 0 20 0;">
               <ImageView fx:id="imgLogo" fitHeight="50" fitWidth="50" preserveRatio="true" />
            </VBox>
            
            <JFXButton fx:id="btnPlaceOrder" text="🛒" onAction="#btnPlaceOrderOnAction" 
                       styleClass="sidebar-icon-btn" />
            
            <JFXButton fx:id="btnCustomer" text="👥" onAction="#btnCustomerOnAction" 
                       styleClass="sidebar-icon-btn" />
            
            <JFXButton fx:id="btnPendingPayments" text="💳" onAction="#btnPendingPaymentsOnAction" 
                       styleClass="sidebar-icon-btn" />
            
            <JFXButton fx:id="btnReturns" text="🔄" onAction="#btnReturnsOnAction" 
                       styleClass="sidebar-icon-btn" />
            
            <JFXButton fx:id="btnOrderDetails" text="📋" onAction="#btnOrderDetailsOnAction" 
                       styleClass="sidebar-icon-btn" />
            
            <VBox VBox.vgrow="ALWAYS" />
            
            <JFXButton fx:id="btnLogout" text="🚪" onAction="#btnLogoutOnAction" 
                       styleClass="sidebar-icon-btn" style="-fx-text-fill: #ef4444;"/>
            
            <!-- Hidden info but kept for controller compatibility -->
            <VBox visible="false" managed="false">
               <Text fx:id="txtUserEmail" />
               <Text fx:id="txtUserRole" />
            </VBox>
         </children>
      </VBox>

      <!-- Content Area -->
      <StackPane fx:id="contentPane" AnchorPane.leftAnchor="80" AnchorPane.rightAnchor="0"
                 AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                 style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 0 1;">
      </StackPane>

   </children>
</AnchorPane>
