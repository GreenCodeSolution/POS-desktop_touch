<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>

<AnchorPane fx:id="mainContext" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.devstack.pos.controller.MainFormController"
            stylesheets="@styles/modern-touch.css"
            styleClass="background-touch">
   <children>

      <!-- Modern Touch-Optimized Sidebar -->
      <VBox prefWidth="250" spacing="10" styleClass="sidebar-light"
            AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
            style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 0);">
         <padding>
            <Insets top="20" right="15" bottom="20" left="15" />
         </padding>
         <children>
            <VBox spacing="10" alignment="CENTER" style="-fx-padding: 0 0 20 0;">
               <ImageView fx:id="imgLogo" fitHeight="60" fitWidth="60" preserveRatio="true" />
               <Label fx:id="lblBusinessName" text="GreenCode POS" 
                      style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
            </VBox>
            
            <JFXButton fx:id="btnPlaceOrder" text="🛒 POS Terminal" onAction="#btnPlaceOrderOnAction" 
                       styleClass="btn-touch" maxWidth="Infinity" alignment="CENTER_LEFT"
                       style="-fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-padding: 15 20;"/>
            
            <JFXButton fx:id="btnCustomer" text="👥 Customers" onAction="#btnCustomerOnAction" 
                       styleClass="btn-touch" maxWidth="Infinity" alignment="CENTER_LEFT"
                       style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-padding: 15 20;"/>
            
            <JFXButton fx:id="btnPendingPayments" text="💳 Payments" onAction="#btnPendingPaymentsOnAction" 
                       styleClass="btn-touch" maxWidth="Infinity" alignment="CENTER_LEFT"
                       style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-padding: 15 20;"/>
            
            <JFXButton fx:id="btnReturns" text="🔄 Returns" onAction="#btnReturnsOnAction" 
                       styleClass="btn-touch" maxWidth="Infinity" alignment="CENTER_LEFT"
                       style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-padding: 15 20;"/>
            
            <JFXButton fx:id="btnOrderDetails" text="📋 History" onAction="#btnOrderDetailsOnAction" 
                       styleClass="btn-touch" maxWidth="Infinity" alignment="CENTER_LEFT"
                       style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-padding: 15 20;"/>
            
            <VBox VBox.vgrow="ALWAYS" />
            
            <Separator style="-fx-opacity: 0.5;"/>
            
            <VBox spacing="5" style="-fx-padding: 10 0;">
               <Text fx:id="txtUserEmail" style="-fx-fill: #94a3b8; -fx-font-size: 11px;" />
               <Text fx:id="txtUserRole" style="-fx-fill: #64748b; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-transform: uppercase;" />
            </VBox>
            
            <JFXButton fx:id="btnLogout" text="🚪 Sign Out" onAction="#btnLogoutOnAction" 
                       styleClass="btn-touch" maxWidth="Infinity" 
                       style="-fx-background-color: #fef2f2; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
         </children>
      </VBox>

      <!-- Content Area with subtle border -->
      <StackPane fx:id="contentPane" AnchorPane.leftAnchor="250" AnchorPane.rightAnchor="0"
                 AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                 style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 0 1;">
      </StackPane>

   </children>
</AnchorPane>
