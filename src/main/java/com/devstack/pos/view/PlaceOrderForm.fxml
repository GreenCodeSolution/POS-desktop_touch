<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<AnchorPane fx:id="context" styleClass="background-touch" xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.devstack.pos.controller.PlaceOrderFormController"
            stylesheets="@styles/modern-touch.css">
    <children>
        <GridPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" percentWidth="70.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="30.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
            </rowConstraints>
            
            <children>
                <!-- Left Section: Product Browser -->
                <VBox spacing="20" style="-fx-padding: 30;" GridPane.columnIndex="0">
                    <children>
                        <!-- Header & Search -->
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <children>
                                <Text text="Point of Sale" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #1e293b;"/>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-background-color: white; -fx-background-radius: 30; -fx-padding: 5 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 3, 0, 0, 1);">
                                    <Label text="🔍" style="-fx-font-size: 20px;"/>
                                    <JFXTextField fx:id="txtBarcode" onAction="#loadProduct" promptText="Search products or scan barcode..." 
                                                  prefWidth="400" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 16px;"/>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- Category Filters (Dynamic) -->
                        <HBox fx:id="categoryPane" spacing="12" style="-fx-padding: 10 0;">
                            <children>
                                <!-- Category buttons will be injected here -->
                            </children>
                        </HBox>

                        <!-- Product Grid Area -->
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
                            <content>
                                <FlowPane fx:id="productGrid" hgap="20" vgap="20" style="-fx-padding: 10;">
                                    <!-- Product Tiles will be injected here programmatically -->
                                </FlowPane>
                            </content>
                        </ScrollPane>

                        <!-- Invisible Fields for compatibility with existing controller logic (can be hidden) -->
                        <HBox visible="false" managed="false">
                            <JFXTextField fx:id="txtDescription" />
                            <JFXTextField fx:id="txtSellingPrice" />
                            <JFXTextField fx:id="txtQtyOnHand" />
                            <JFXTextField fx:id="txtDiscount" text="0.0"/>
                            <JFXTextField fx:id="txtQty" text="1"/>
                            <ImageView fx:id="imgProduct" />
                        </HBox>
                    </children>
                </VBox>

                <!-- Right Section: Cart & Checkout Sidebar -->
                <VBox spacing="0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, -2, 0);" GridPane.columnIndex="1">
                    <children>
                        <!-- Selected Customer -->
                        <VBox spacing="10" style="-fx-padding: 25; -fx-background-color: #f8fafc;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Text text="Current Order" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #1e293b;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <JFXButton text="＋ Customer" onAction="#btnAddNewCustomerOnAction" style="-fx-text-fill: #4f46e5; -fx-font-weight: bold;"/>
                                </HBox>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <ImageView fitHeight="40" fitWidth="40" preserveRatio="true" opacity="0.5">
                                        <image><Image url="@../../../../../resources/images/user-icon.png"/></image>
                                    </ImageView>
                                    <VBox spacing="2">
                                        <JFXTextField fx:id="txtContact" onAction="#searchCustomer" promptText="Enter Phone Number" style="-fx-font-size: 14px; -fx-pref-height: 30;"/>
                                        <Text fx:id="txtName" text="Walk-in Customer" style="-fx-fill: #64748b; -fx-font-size: 13px;"/>
                                    </VBox>
                                </HBox>
                            </children>
                        </VBox>

                                <VBox spacing="10" style="-fx-padding: 15 25; -fx-background-color: #f0f7ff; -fx-border-color: #dbeafe; -fx-border-width: 0 0 1 0;">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Text text="Loyalty Points" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #1e40af;"/>
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Text fx:id="txtCustomerLoyaltyPoints" text="Aval: 0.0" style="-fx-fill: #1e40af; -fx-font-weight: bold;"/>
                                        </HBox>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <JFXTextField fx:id="txtPointsToUse" onKeyReleased="#calculateBalance" promptText="Redeem Points" HBox.hgrow="ALWAYS" style="-fx-font-size: 13px;"/>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Cart Items Table -->
                                <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 10;">
                                    <children>
                                        <TableView fx:id="tblCart" styleClass="table-view-modern" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colCode" prefWidth="100.0" text="Code" visible="false"/>
                                                <TableColumn fx:id="colDesc" prefWidth="150.0" text="Item"/>
                                                <TableColumn fx:id="colSelPrice" prefWidth="120.0" text="Price"/>
                                                <TableColumn fx:id="colSelQty" prefWidth="80.0" text="Qty"/>
                                                <TableColumn fx:id="colSelDisc" prefWidth="100.0" text="Disc" visible="false"/>
                                                <TableColumn fx:id="colSelTotal" prefWidth="120.0" text="Total"/>
                                                <TableColumn fx:id="colSelOperation" prefWidth="150.0" text=""/>
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>

                        <!-- Payment & Summary -->
                        <VBox spacing="15" style="-fx-padding: 25; -fx-background-color: #ffffff; -fx-border-color: #f1f5f9; -fx-border-width: 1 0 0 0;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <Text text="Subtotal" style="-fx-fill: #64748b; -fx-font-size: 16px;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Text fx:id="txtTotal" text="0.00 /=" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #1e293b;"/>
                                </HBox>
                                
                                <VBox spacing="8">
                                    <Text text="Payment Method" style="-fx-fill: #64748b; -fx-font-size: 14px;"/>
                                    <JFXComboBox fx:id="cmbPaymentMethod" maxWidth="Infinity" style="-fx-font-size: 14px; -fx-pref-height: 40;"/>
                                </VBox>

                                <HBox alignment="CENTER_LEFT">
                                    <Text text="Points to Earn" style="-fx-fill: #14b8a6; -fx-font-size: 14px;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Text fx:id="txtPointsToEarn" text="+0.0" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-fill: #14b8a6;"/>
                                </HBox>

                                <HBox spacing="10">
                                    <children>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Text text="Cash Received" style="-fx-fill: #64748b; -fx-font-size: 13px;"/>
                                            <JFXTextField fx:id="txtCustomerPaid" onKeyReleased="#calculateBalance" promptText="0.00" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                                        </VBox>
                                        <VBox spacing="5" alignment="TOP_RIGHT">
                                            <Text text="Balance" style="-fx-fill: #64748b; -fx-font-size: 13px;"/>
                                            <Text fx:id="txtBalance" text="0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #ef4444;"/>
                                        </VBox>
                                    </children>
                                </HBox>

                                <JFXButton onAction="#btnCompleteOrder" text="COMPLETE TRANSACTION" 
                                           styleClass="btn-touch, btn-touch-primary" maxWidth="Infinity" prefHeight="70"
                                           style="-fx-font-size: 18px;"/>
                                           
                                <JFXButton fx:id="btnPrint" onAction="#btnPrintReceipt" text="🖨️ Print Last Receipt" 
                                           styleClass="btn-touch" maxWidth="Infinity"
                                           style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-size: 14px;"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </GridPane>
        
    </children>
</AnchorPane>
