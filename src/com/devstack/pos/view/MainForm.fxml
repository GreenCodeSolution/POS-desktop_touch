<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>

<AnchorPane fx:id="mainContext" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.devstack.pos.controller.MainFormController"
            stylesheets="@styles/modern-dashboard.css"
            style="-fx-background-color: linear-gradient(to bottom right, #f4f4f9, #ffffff);">
   <children>

      <!-- Original Sidebar -->
      <VBox prefWidth="230" spacing="20" styleClass="sidebar-light"
            AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
         <padding>
            <Insets top="10" right="15" bottom="30" left="15" />
         </padding>
         <children>
            <VBox spacing="8" alignment="CENTER">
               <ImageView fx:id="imgLogo" fitHeight="70" fitWidth="80" preserveRatio="true" />
               <Label fx:id="lblBusinessName" text="Kumara Hardware" styleClass="sidebar-title-light" style="-fx-text-fill: black; -fx-font-weight: bold;" wrapText="true" maxWidth="200" textAlignment="CENTER" alignment="CENTER"/>
            </VBox>
            <Separator style="-fx-max-width: 180; -fx-background-color: #DDDDDD;"/>
            <JFXButton fx:id="btnCustomer" text="👥 Customers" onAction="#btnCustomerOnAction" styleClass="sidebar-btn-light" />
            <JFXButton fx:id="btnPlaceOrder" text="🛒 POS / Orders" onAction="#btnPlaceOrderOnAction" styleClass="sidebar-btn-light" />
            <JFXButton fx:id="btnPendingPayments" text="💳 Pending Payments" onAction="#btnPendingPaymentsOnAction" styleClass="sidebar-btn-light" />
            <JFXButton fx:id="btnReturns" text="🔄 Return Orders" onAction="#btnReturnsOnAction" styleClass="sidebar-btn-light" />
            <JFXButton fx:id="btnOrderDetails" text="📋 All Orders" onAction="#btnOrderDetailsOnAction" styleClass="sidebar-btn-light" />
            
            <Separator style="-fx-max-width: 190; -fx-background-color: #DDDDDD;"/>
            
            <JFXButton fx:id="btnHelp" text="❓ Help" onAction="#btnHelpOnAction" styleClass="sidebar-btn-light" />
            
            <VBox VBox.vgrow="ALWAYS" />
            
            <Separator style="-fx-max-width: 190; -fx-background-color: #DDDDDD;"/>
            <VBox spacing="10" alignment="CENTER_LEFT">
               <VBox spacing="3">
                  <Text fx:id="txtUserEmail" style="-fx-fill: #64748b; -fx-font-size: 11px;" />
                  <Text fx:id="txtUserRole" style="-fx-fill: #64748b; -fx-font-size: 10px; -fx-font-weight: bold;" />
               </VBox>
               <JFXButton fx:id="btnLogout" text="🚪 Logout" onAction="#btnLogoutOnAction" styleClass="sidebar-btn-light" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;" />
            </VBox>

         </children>
      </VBox>

      <!-- Content Area -->
      <StackPane fx:id="contentPane" AnchorPane.leftAnchor="220" AnchorPane.rightAnchor="0"
                 AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
      </StackPane>

   </children>
</AnchorPane>
